# Postgres connection string (Neon, set up through the Vercel project's Storage tab)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Long random string used to sign Payload auth tokens. Generate with: openssl rand -hex 32
PAYLOAD_SECRET=

# Optional locally. Required on Vercel so uploaded images persist (Vercel Blob store token).
BLOB_READ_WRITE_TOKEN=
